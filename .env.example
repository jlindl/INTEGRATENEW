# ─────────────────────────────────────────────────────────────
# GoHighLevel (LeadConnector) — "Book a call" form
# Copy this file to .env.local and fill in the values.
# Used by app/api/book-call/route.ts.
# ─────────────────────────────────────────────────────────────

# OPTION 1 (recommended) — Inbound Webhook.
# In GHL: Automation → Workflows → new Workflow → trigger "Inbound Webhook",
# copy the webhook URL here. Captures every field (incl. the message) for you
# to map to a contact + notification. If set, this is used first.
GHL_WEBHOOK_URL=

# OPTION 2 — Contacts API (creates/updates a contact directly).
# GHL: Settings → Private Integrations → create one with the Contacts scope.
GHL_API_TOKEN=
# GHL: Settings → Business Profile (the sub-account / Location ID).
GHL_LOCATION_ID=

# Optional — override the API base (rarely needed).
GHL_API_BASE=https://services.leadconnectorhq.com

# Optional — extra tag added to every contact created from the site.
GHL_BOOKING_TAG=book-a-call
